{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "編譯 C++ 候位系統",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-fdiagnostics-color=always",
        "${workspaceFolder}/main.cpp",
        "-o",
        "${workspaceFolder}/queue-system.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
